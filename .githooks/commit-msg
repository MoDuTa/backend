#!/usr/bin/env bash
# 커밋 메시지 형식 검사 (CONTRIBUTING.md의 커밋 규칙)
# 설치: git config core.hooksPath .githooks
# PR 규칙 워크플로도 이 스크립트로 PR의 커밋을 검사합니다. 그때는 BRANCH 환경변수로 브랜치를 넘깁니다.
set -euo pipefail

msg_file="$1"
first_line="$(grep -v '^#' "$msg_file" | sed -n '1p' || true)"
second_line="$(grep -v '^#' "$msg_file" | sed -n '2p' || true)"

# git이 만드는 머지·되돌리기·fixup 커밋은 검사하지 않습니다.
case "$first_line" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

fail() {
  echo "커밋 메시지 형식 오류: $1" >&2
  echo "  입력: $first_line" >&2
  echo "  형식: [머리말]_WBS번호/요약   예: [Feat]_2.3.1/RentalReturn" >&2
  echo "  머리말: [Feat] [Fix] [Infra] [Docs] [Test] [Refactor] [Chore] [Style]" >&2
  exit 1
}

pattern='^\[(Feat|Fix|Infra|Docs|Test|Refactor|Chore|Style)\]_([0-9]+(\.[0-9]+)*)/[A-Z][A-Za-z0-9]*$'
if [[ ! "$first_line" =~ $pattern ]]; then
  fail "첫 줄이 형식에 맞지 않습니다. 요약은 공백 없는 영문 PascalCase로 적습니다."
fi
header="${BASH_REMATCH[1]}"
wbs="${BASH_REMATCH[2]}"

if [[ -n "$second_line" ]]; then
  fail "첫 줄 아래는 빈 줄로 두고, 변경 내용은 그 아래에 적습니다."
fi

# 규칙에 맞는 브랜치에서는 머리말과 WBS 번호가 브랜치와 같은지도 확인합니다.
branch="${BRANCH:-$(git symbolic-ref --short -q HEAD || true)}"
branch_pattern='^(feat|fix|infra|docs|test|refactor|chore|style)/([0-9]+(\.[0-9]+)*)-'
if [[ "$branch" =~ $branch_pattern ]]; then
  branch_type="${BASH_REMATCH[1]}"
  branch_wbs="${BASH_REMATCH[2]}"
  expected="$(printf '%s' "${branch_type:0:1}" | tr '[:lower:]' '[:upper:]')${branch_type:1}"
  if [[ "$header" != "$expected" ]]; then
    fail "$branch 브랜치의 커밋 머리말은 [$expected]입니다."
  fi
  if [[ "$wbs" != "$branch_wbs" ]]; then
    fail "$branch 브랜치의 WBS 번호는 $branch_wbs입니다."
  fi
fi
